<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:PoR.App.ViewModels"
        xmlns:views="using:PoR.App.Views"
        xmlns:loc="using:PoR.App.Localization"
        x:Class="PoR.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="{loc:Tr Ui_App_Title}"
        Icon="/Assets/icon.ico"
        Width="1180"
        Height="760"
        MinWidth="980"
        MinHeight="620"
        FontFamily="Microsoft YaHei UI"
        TransparencyLevelHint="Mica, AcrylicBlur, None"
        Background="Transparent">

    <Grid RowDefinitions="52,*,28">
        <Border Grid.Row="0"
                Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                BorderThickness="0,0,0,1"
                Padding="12,0">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <TextBlock Text="{loc:Tr Ui_App_Title}"
                           FontSize="15"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center" />

                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            Spacing="8"
                            VerticalAlignment="Center">
                    <Border Background="{DynamicResource SystemControlBackgroundBaseLowBrush}"
                            CornerRadius="10"
                            Padding="10,3">
                        <TextBlock Text="{Binding ConnectionText}"
                                   FontSize="12"
                                   VerticalAlignment="Center" />
                    </Border>

                    <ComboBox Width="92"
                              ItemsSource="{Binding Languages}"
                              SelectedItem="{Binding SelectedLanguage, Mode=TwoWay}"
                              MinHeight="30">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:LanguageOption">
                                <TextBlock Text="{Binding Name}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <ToggleButton Content="{Binding ThemeButtonText}"
                                  IsChecked="{Binding IsDarkTheme, Mode=TwoWay}"
                                  MinHeight="30" />

                    <Button Content="{loc:Tr Ui_Action_Refresh}"
                            Command="{Binding RefreshCommand}"
                            IsEnabled="{Binding IsNotBusy}"
                            MinHeight="30" />
                    <Button Content="{loc:Tr Ui_Action_Reconnect}"
                            Command="{Binding ReconnectCommand}"
                            IsEnabled="{Binding IsNotBusy}"
                            MinHeight="30" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" ColumnDefinitions="300,*">
            <Border Grid.Column="0"
                    Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                    BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                    BorderThickness="0,0,1,0">
                <Grid RowDefinitions="*,Auto">
                    <ListBox ItemsSource="{Binding Slots}"
                             SelectedItem="{Binding SelectedSlot}"
                             Background="Transparent"
                             BorderThickness="0"
                             Margin="6">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:CharacterSlotViewModel">
                                <Grid ColumnDefinitions="48,*" Margin="2">
                                    <Border Width="40"
                                            Height="40"
                                            CornerRadius="4"
                                            ClipToBounds="True"
                                            Background="{DynamicResource SystemControlBackgroundBaseLowBrush}">
                                        <Image Source="{Binding Avatar}"
                                               Stretch="UniformToFill" />
                                    </Border>
                                    <StackPanel Grid.Column="1"
                                                Margin="8,0,0,0"
                                                VerticalAlignment="Center">
                                        <TextBlock Text="{Binding DisplayName}"
                                                   FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding ClassName}"
                                                   FontSize="11"
                                                   Opacity="0.7"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Button Grid.Row="1"
                            Content="{loc:Tr Ui_Action_RefreshList}"
                            Command="{Binding RefreshCommand}"
                            IsEnabled="{Binding IsNotBusy}"
                            Margin="8"
                            MinHeight="32" />
                </Grid>
            </Border>

            <TabControl Grid.Column="1" Margin="8,6,8,6">
                <TabItem Header="{loc:Tr Ui_Tab_Status}">
                    <views:StatusView DataContext="{Binding StatusTab}" />
                </TabItem>
                <TabItem Header="{loc:Tr Ui_Tab_Ability}">
                    <TextBlock Text="{loc:Tr Ui_Status_Dev}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Opacity="0.6" />
                </TabItem>
                <TabItem Header="{loc:Tr Ui_Tab_Skill}">
                    <TextBlock Text="{loc:Tr Ui_Status_Dev}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Opacity="0.6" />
                </TabItem>
                <TabItem Header="{loc:Tr Ui_Tab_Item}">
                    <TextBlock Text="{loc:Tr Ui_Status_Dev}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Opacity="0.6" />
                </TabItem>
                <TabItem Header="{loc:Tr Ui_Tab_Support}">
                    <TextBlock Text="{loc:Tr Ui_Status_Dev}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Opacity="0.6" />
                </TabItem>
                <TabItem Header="{loc:Tr Ui_Tab_Other}">
                    <TextBlock Text="{loc:Tr Ui_Status_Dev}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Opacity="0.6" />
                </TabItem>
            </TabControl>
        </Grid>

        <Border Grid.Row="2"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                BorderThickness="0,1,0,0"
                Padding="10,0">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <TextBlock Text="{Binding LastRefreshText}"
                           FontSize="11"
                           VerticalAlignment="Center"
                           Opacity="0.7" />
                <TextBlock Grid.Column="2"
                           Text="{Binding ErrorMessage}"
                           IsVisible="{Binding HasError}"
                           FontSize="11"
                           Foreground="{DynamicResource SystemControlErrorTextForegroundBrush}"
                           TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center" />
            </Grid>
        </Border>
    </Grid>
</Window>
