<fa:FAAppWindow xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:fa="using:FluentAvalonia.UI.Windowing"
        xmlns:vm="using:PoR.App.ViewModels"
        xmlns:views="using:PoR.App.Views"
        xmlns:controls="using:PoR.App.Controls"
        xmlns:loc="using:PoR.App.Localization"
        x:Class="PoR.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="{loc:Tr Ui_App_Title}"
        Icon="/Assets/icon.ico"
        Width="1260"
        Height="800"
        WindowStartupLocation="CenterScreen"
        CanResize="False"
        CanMaximize="False"
        FontFamily="Microsoft YaHei UI"
        Background="{DynamicResource AppBackgroundBrush}">

    <Grid RowDefinitions="*,44">
        <Grid Grid.Row="0" ColumnDefinitions="280,*">
            <Border Grid.Column="0"
                    Background="{DynamicResource AppSurfaceAltBrush}"
                    BorderBrush="{DynamicResource AppBorderBrush}"
                    BorderThickness="0,0,1,0">
                <ListBox ItemsSource="{Binding Slots}"
                         SelectedItem="{Binding SelectedSlot}"
                         Background="Transparent"
                         BorderThickness="0"
                         Margin="6">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:CharacterSlotViewModel">
                            <Grid ColumnDefinitions="64,*" Margin="2">
                                <Border Width="56"
                                        Height="56"
                                        CornerRadius="6"
                                        ClipToBounds="True"
                                        Background="Transparent">
                                    <Image Source="{Binding Avatar}"
                                           Stretch="UniformToFill" />
                                </Border>
                                <StackPanel Grid.Column="1"
                                            Margin="10,0,0,0"
                                            VerticalAlignment="Center">
                                    <TextBlock Text="{Binding DisplayName}"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding ClassName}"
                                               FontSize="11"
                                               Opacity="0.7"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <controls:CompactTabControl Grid.Column="1" Margin="4,4,4,2">
                <TabItem Header="{loc:Tr Ui_Tab_Status}">
                    <views:StatusView DataContext="{Binding StatusTab}" />
                </TabItem>
                <TabItem Header="{loc:Tr Ui_Tab_Ability}">
                    <views:AbilityView DataContext="{Binding AbilityTab}" />
                </TabItem>
                <TabItem Header="{loc:Tr Ui_Tab_Skill}">
                    <views:SkillView DataContext="{Binding SkillTab}" />
                </TabItem>
                <TabItem Header="{loc:Tr Ui_Tab_Item}">
                    <views:ItemView DataContext="{Binding ItemTab}" />
                </TabItem>
                <TabItem Header="{loc:Tr Ui_Tab_Support}">
                    <views:SupportView DataContext="{Binding SupportTab}" />
                </TabItem>
                <TabItem Header="{loc:Tr Ui_Tab_Other}">
                    <views:OtherView DataContext="{Binding OtherTab}" />
                </TabItem>
            </controls:CompactTabControl>
        </Grid>

        <Border Grid.Row="1"
                Background="{DynamicResource AppSurfaceAltBrush}"
                BorderBrush="{DynamicResource AppBorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="10,0">
            <Grid ColumnDefinitions="*,Auto">
                <Grid ColumnDefinitions="Auto,Auto,Auto,*"
                      VerticalAlignment="Center">
                    <TextBlock Text="●"
                               FontSize="12"
                               Foreground="{Binding ConnectionBrush}"
                               VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1"
                               Text="{Binding ConnectionText}"
                               FontSize="12"
                               Margin="10,0,0,0"
                               VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2"
                               Text="{Binding LastRefreshText}"
                               FontSize="11"
                               Opacity="0.65"
                               Margin="10,0,0,0"
                               VerticalAlignment="Center" />
                    <TextBlock Grid.Column="3"
                               Text="{Binding ErrorMessage}"
                               IsVisible="{Binding HasError}"
                               ToolTip.Tip="{Binding ErrorMessage}"
                               FontSize="11"
                               Foreground="#E81123"
                               TextTrimming="CharacterEllipsis"
                               Margin="10,0,0,0"
                               VerticalAlignment="Center" />
                </Grid>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            Spacing="8"
                            VerticalAlignment="Center">
                    <Button Command="{Binding RefreshCommand}"
                            IsEnabled="{Binding IsNotBusy}"
                            Classes="accent"
                            Width="96"
                            HorizontalContentAlignment="Center">
                        <StackPanel Orientation="Horizontal"
                                    Spacing="6">
                            <TextBlock Text="&#xE72C;"
                                       FontFamily="Segoe Fluent Icons"
                                       FontSize="14"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="{loc:Tr Ui_Action_Refresh}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding ReconnectCommand}"
                            IsEnabled="{Binding IsNotBusy}"
                            Width="96"
                            HorizontalContentAlignment="Center">
                        <StackPanel Orientation="Horizontal"
                                    Spacing="6">
                            <TextBlock Text="&#xE895;"
                                       FontFamily="Segoe Fluent Icons"
                                       FontSize="14"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="{loc:Tr Ui_Action_Reconnect}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding ToggleThemeCommand}"
                            ToolTip.Tip="{loc:Tr Ui_Action_Theme}"
                            Width="96"
                            HorizontalContentAlignment="Center">
                        <StackPanel Orientation="Horizontal"
                                    Spacing="6">
                            <TextBlock Text="{Binding ThemeIcon}"
                                       FontFamily="Segoe Fluent Icons"
                                       FontSize="14"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="{Binding ThemeButtonText}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding ToggleLanguageCommand}"
                            ToolTip.Tip="{loc:Tr Ui_Action_Language}"
                            Width="96"
                            HorizontalContentAlignment="Center">
                        <StackPanel Orientation="Horizontal"
                                    Spacing="6">
                            <TextBlock Text="&#xE774;"
                                       FontFamily="Segoe Fluent Icons"
                                       FontSize="14"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="{Binding LanguageButtonText}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</fa:FAAppWindow>
