<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PoR.App.ViewModels"
             xmlns:loc="using:PoR.App.Localization"
             x:Class="PoR.App.Views.SkillView"
             x:DataType="vm:SkillTabViewModel">

    <Grid ColumnDefinitions="*,*">
        <Border Grid.Column="0"
                Classes="card"
                Padding="10"
                Margin="4"
                VerticalAlignment="Stretch">
            <Grid RowDefinitions="Auto,*">
                <TextBlock Classes="sectionTitle"
                           Text="{loc:Tr Ui_Skill_Active}" />
                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding ActiveSkills}" />
                </ScrollViewer>
            </Grid>
        </Border>

        <Border Grid.Column="1"
                Classes="card"
                Padding="10"
                Margin="4"
                VerticalAlignment="Stretch">
            <Grid RowDefinitions="Auto,*">
                <TextBlock Classes="sectionTitle"
                           Text="{loc:Tr Ui_Skill_Features}" />
                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding Features}" />
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
