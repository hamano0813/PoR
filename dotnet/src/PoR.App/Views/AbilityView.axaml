<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PoR.App.ViewModels"
             xmlns:loc="using:PoR.App.Localization"
             x:Class="PoR.App.Views.AbilityView"
             x:DataType="vm:AbilityTabViewModel">

    <Border Classes="card"
            Padding="12"
            Margin="4"
            HorizontalAlignment="Center"
            VerticalAlignment="Top">
        <StackPanel>
            <Grid ColumnDefinitions="80,110,110,50,110">
                <TextBlock Grid.Column="1"
                           Classes="columnHeader"
                           Text="{loc:Tr Ui_Ability_Stats}" />
                <TextBlock Grid.Column="2"
                           Classes="columnHeader"
                           Text="{loc:Tr Ui_Ability_Growth}" />
                <TextBlock Grid.Column="4"
                           Classes="columnHeader"
                           Text="{loc:Tr Ui_Ability_Proficiency}" />
            </Grid>

            <ItemsControl ItemsSource="{Binding Rows}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:AbilityRowViewModel">
                        <Grid ColumnDefinitions="80,110,110,50,110">
                            <Border Classes="fieldLabel">
                                <TextBlock Text="{Binding Label}" />
                            </Border>
                            <ContentControl Grid.Column="1" Content="{Binding Stat}" />
                            <ContentControl Grid.Column="2" Content="{Binding Growth}" />
                            <Image Grid.Column="3"
                                   Source="{Binding WeaponIcon}"
                                   Width="26"
                                   Height="26"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   IsVisible="{Binding HasWeapon}"
                                   ToolTip.Tip="{Binding WeaponLabel}" />
                            <ContentControl Grid.Column="4" Content="{Binding Proficiency}" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </Border>
</UserControl>
