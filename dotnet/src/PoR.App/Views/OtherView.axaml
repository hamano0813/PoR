<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PoR.App.ViewModels"
             xmlns:fa="using:FluentAvalonia.UI.Controls"
             x:Class="PoR.App.Views.OtherView"
             x:DataType="vm:OtherTabViewModel">

    <Border Classes="card"
            Width="620"
            Padding="16"
            Margin="4"
            HorizontalAlignment="Center"
            VerticalAlignment="Top">
        <StackPanel>
            <fa:FAInfoBar IsOpen="True"
                          Severity="Warning"
                          Title="{Binding WarningText}"
                          IsClosable="False"
                          Margin="0,0,0,10" />

            <TextBlock Text="{Binding InfoText}"
                       FontSize="12"
                       LineHeight="20"
                       TextWrapping="Wrap"
                       Opacity="0.85"
                       Margin="2" />
        </StackPanel>
    </Border>
</UserControl>
