<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PoR.App.ViewModels"
             x:Class="PoR.App.Views.ItemView"
             x:DataType="vm:ItemTabViewModel">

    <Border Classes="card"
            Padding="12"
            Margin="4"
            HorizontalAlignment="Center"
            VerticalAlignment="Top">
        <ItemsControl ItemsSource="{Binding Rows}">
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:ItemRowViewModel">
                    <Grid ColumnDefinitions="270,110,100,110">
                        <ContentControl Grid.Column="0" Content="{Binding Item}" />
                        <ContentControl Grid.Column="1" Content="{Binding Durability}" />
                        <ContentControl Grid.Column="2" Content="{Binding Equipped}" />
                        <ContentControl Grid.Column="3" Content="{Binding Dropped}" />
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Border>
</UserControl>
