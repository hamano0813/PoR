<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="PoR.App.App"
             xmlns:local="using:PoR.App"
             xmlns:fields="using:PoR.App.ViewModels.Fields"
             xmlns:controls="using:PoR.App.Controls"
             xmlns:sty="using:FluentAvalonia.Styling"
             RequestedThemeVariant="Default">

    <Application.DataTemplates>
        <local:ViewLocator />

        <DataTemplate DataType="{x:Type fields:NumericFieldViewModel}"
                      x:DataType="fields:NumericFieldViewModel">
            <Border Background="{DynamicResource AppInputBackgroundBrush}"
                    BorderBrush="{DynamicResource AppBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Height="32"
                    Margin="2,3,0,3"
                    IsEnabled="{Binding IsEditable}">
                <Grid ColumnDefinitions="26,*,26">
                    <RepeatButton Grid.Column="0"
                                  Classes="spinnerButton"
                                  Width="26"
                                  Height="26"
                                  MinWidth="0"
                                  MinHeight="0"
                                  Margin="3,0,0,0"
                                  Padding="0"
                                  VerticalAlignment="Center"
                                  CornerRadius="4"
                                  IsTabStop="False"
                                  Command="{Binding DecrementCommand}">
                        <Path Data="M 4,0 L 0,4 L 4,8"
                              Stroke="{DynamicResource AppForegroundBrush}"
                              StrokeThickness="1.2"
                              StrokeLineCap="Round"
                              Width="5"
                              Height="9"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center" />
                    </RepeatButton>
                    <TextBox Grid.Column="1"
                             Text="{Binding Value, Mode=TwoWay}"
                             TextAlignment="Center"
                             HorizontalContentAlignment="Center"
                             VerticalContentAlignment="Center"
                             Background="Transparent"
                             BorderThickness="0"
                             MinHeight="0"
                             Padding="0"
                             FontSize="12"
                             VerticalAlignment="Stretch" />
                    <RepeatButton Grid.Column="2"
                                  Classes="spinnerButton"
                                  Width="26"
                                  Height="26"
                                  MinWidth="0"
                                  MinHeight="0"
                                  Margin="0,0,3,0"
                                  Padding="0"
                                  VerticalAlignment="Center"
                                  CornerRadius="4"
                                  IsTabStop="False"
                                  Command="{Binding IncrementCommand}">
                        <Path Data="M 0,0 L 4,4 L 0,8"
                              Stroke="{DynamicResource AppForegroundBrush}"
                              StrokeThickness="1.2"
                              StrokeLineCap="Round"
                              Width="5"
                              Height="9"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center" />
                    </RepeatButton>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate DataType="{x:Type fields:EnumFieldViewModel}"
                      x:DataType="fields:EnumFieldViewModel">
            <ComboBox ItemsSource="{Binding Items}"
                      SelectedItem="{Binding SelectedItem}"
                      IsEnabled="{Binding IsEditable}"
                      Classes="compact"
                      Height="{Binding EditorHeight}"
                      MaxDropDownHeight="{Binding DropDownHeight}"
                      Margin="2,3,0,3"
                      HorizontalAlignment="Stretch">
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="fields:EnumItemViewModel">
                        <Grid ColumnDefinitions="Auto,*">
                            <Image Source="{Binding Icon}"
                                   Width="{Binding IconSize}"
                                   Height="{Binding IconSize}"
                                   Margin="0,0,6,0"
                                   IsVisible="{Binding HasIcon}" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding DisplayName}"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" />
                        </Grid>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </DataTemplate>

        <DataTemplate DataType="{x:Type fields:BoolFieldViewModel}"
                      x:DataType="fields:BoolFieldViewModel">
            <Grid ColumnDefinitions="Auto,*">
                <Image Source="{Binding Icon}"
                       Width="{Binding IconSize}"
                       Height="{Binding IconSize}"
                       Margin="0,0,6,0"
                       VerticalAlignment="Center"
                       IsVisible="{Binding HasIcon}" />
                <CheckBox Grid.Column="1"
                          Content="{Binding Label}"
                          IsChecked="{Binding IsChecked}"
                          IsEnabled="{Binding IsEditable}"
                          MinHeight="32"
                          Margin="10,3,0,3"
                          VerticalAlignment="Center" />
            </Grid>
        </DataTemplate>

        <DataTemplate DataType="{x:Type fields:TriStateLockFieldViewModel}"
                      x:DataType="fields:TriStateLockFieldViewModel">
            <controls:TriStateLockCheckBox IsThreeState="True"
                                           IsChecked="{Binding StateValue, Mode=TwoWay}"
                                           Content="{Binding DisplayText}"
                                           IsEnabled="{Binding IsEditable}"
                                           MinHeight="32"
                                           Margin="10,3,0,3" />
        </DataTemplate>
    </Application.DataTemplates>

    <Application.Resources>
        <ResourceDictionary>
            <Color x:Key="SystemAccentColor">#0E8FA3</Color>
            <SolidColorBrush x:Key="AccentBrush" Color="#0E8FA3" />
            <SolidColorBrush x:Key="AccentHoverBrush" Color="#14A5BA" />
            <SolidColorBrush x:Key="AccentPressedBrush" Color="#0B7C8C" />

            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#F3F3F3" />
                    <SolidColorBrush x:Key="AppSurfaceBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="AppSurfaceAltBrush" Color="#F7F7F7" />
                    <SolidColorBrush x:Key="AppBorderBrush" Color="#E0E0E0" />
                    <SolidColorBrush x:Key="AppForegroundBrush" Color="#1A1A1A" />
                    <SolidColorBrush x:Key="AppInputBackgroundBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="AppSurfaceHoverBrush" Color="#E9E9E9" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#1F1F1F" />
                    <SolidColorBrush x:Key="AppSurfaceBrush" Color="#2B2B2B" />
                    <SolidColorBrush x:Key="AppSurfaceAltBrush" Color="#252525" />
                    <SolidColorBrush x:Key="AppBorderBrush" Color="#3A3A3A" />
                    <SolidColorBrush x:Key="AppForegroundBrush" Color="#F2F2F2" />
                    <SolidColorBrush x:Key="AppInputBackgroundBrush" Color="#333333" />
                    <SolidColorBrush x:Key="AppSurfaceHoverBrush" Color="#3A3A3A" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <sty:FluentAvaloniaTheme PreferSystemTheme="True"
                                 CustomAccentColor="#0E8FA3" />

        <Style Selector="Button">
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Padding" Value="14,4" />
        </Style>

        <Style Selector="ToggleButton">
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="MinHeight" Value="32" />
        </Style>

        <Style Selector="Button.accent">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>

        <Style Selector="Button.accent /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
        </Style>

        <Style Selector="Button.accent:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentHoverBrush}" />
        </Style>

        <Style Selector="Button.accent:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentPressedBrush}" />
        </Style>

        <Style Selector="Button.accent TextBlock">
            <Setter Property="Foreground" Value="White" />
        </Style>

        <Style Selector="ToggleButton.neutralToggle:checked">
            <Setter Property="Background" Value="{DynamicResource AppSurfaceAltBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource AppForegroundBrush}" />
        </Style>

        <Style Selector="ToggleButton.neutralToggle:checked /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AppSurfaceAltBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource AppForegroundBrush}" />
        </Style>

        <Style Selector="ToggleButton.neutralToggle:checked:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AppSurfaceBrush}" />
        </Style>

        <Style Selector="ToggleButton.neutralToggle:checked:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AppBorderBrush}" />
        </Style>

        <Style Selector="ToggleButton.neutralToggle TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource AppForegroundBrush}" />
        </Style>

        <Style Selector="RepeatButton.spinnerButton">
            <Setter Property="Background" Value="{DynamicResource AppSurfaceAltBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style Selector="RepeatButton.spinnerButton:pointerover">
            <Setter Property="Background" Value="{DynamicResource AppSurfaceHoverBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
        </Style>

        <Style Selector="RepeatButton.spinnerButton:pressed">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
        </Style>

        <Style Selector="TextBox">
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="MinHeight" Value="32" />
        </Style>

        <Style Selector="ComboBox">
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="MinHeight" Value="32" />
        </Style>

        <Style Selector="NumericUpDown">
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="MinHeight" Value="26" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <Style Selector="ComboBox.compact">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="6,2" />
            <Setter Property="MinHeight" Value="26" />
        </Style>

        <Style Selector="TabItem">
            <Setter Property="CornerRadius" Value="6,6,0,0" />
            <Setter Property="Padding" Value="12,5" />
            <Setter Property="FontSize" Value="13" />
        </Style>

        <Style Selector="TabItem:selected">
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
        </Style>

        <Style Selector="ListBoxItem">
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Margin" Value="2" />
            <Setter Property="Padding" Value="4" />
        </Style>

        <Style Selector="ListBoxItem:selected">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Foreground" Value="White" />
        </Style>

        <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Foreground" Value="White" />
        </Style>

        <Style Selector="Border.card">
            <Setter Property="Background" Value="{DynamicResource AppSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>

        <Style Selector="Border.fieldLabel">
            <Setter Property="Background" Value="{DynamicResource AppSurfaceAltBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="Padding" Value="6,3" />
            <Setter Property="Margin" Value="2,3,0,3" />
            <Setter Property="MinHeight" Value="32" />
        </Style>

        <Style Selector="Border.fieldLabel > TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextAlignment" Value="Center" />
        </Style>

        <Style Selector="TextBlock.sectionTitle">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="2,0,0,8" />
        </Style>

        <Style Selector="TextBlock.columnHeader">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Opacity" Value="0.7" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
    </Application.Styles>
</Application>
