<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="PoR.App.App"
             xmlns:local="using:PoR.App"
             xmlns:fields="using:PoR.App.ViewModels.Fields"
             xmlns:controls="using:PoR.App.Controls"
             xmlns:sty="using:FluentAvalonia.Styling"
             RequestedThemeVariant="Default">

    <Application.DataTemplates>
        <local:ViewLocator />

        <DataTemplate DataType="{x:Type fields:NumericFieldViewModel}"
                      x:DataType="fields:NumericFieldViewModel">
            <NumericUpDown Value="{Binding Value}"
                           Minimum="{Binding Minimum}"
                           Maximum="{Binding Maximum}"
                           IsEnabled="{Binding IsEditable}"
                           FormatString="0"
                           Increment="1"
                           ShowButtonSpinner="True"
                           TextAlignment="Center"
                           HorizontalContentAlignment="Center"
                           Height="32"
                           Margin="2,3,0,3"
                           HorizontalAlignment="Stretch" />
        </DataTemplate>

        <DataTemplate DataType="{x:Type fields:EnumFieldViewModel}"
                      x:DataType="fields:EnumFieldViewModel">
            <ComboBox ItemsSource="{Binding Items}"
                      SelectedItem="{Binding SelectedItem}"
                      IsEnabled="{Binding IsEditable}"
                      Classes="compact"
                      Height="{Binding EditorHeight}"
                      MaxDropDownHeight="{Binding DropDownHeight}"
                      Margin="2,3,0,3"
                      HorizontalAlignment="Stretch">
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="fields:EnumItemViewModel">
                        <Grid ColumnDefinitions="Auto,*">
                            <Image Source="{Binding Icon}"
                                   Width="{Binding IconSize}"
                                   Height="{Binding IconSize}"
                                   Margin="0,0,6,0"
                                   IsVisible="{Binding HasIcon}" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding DisplayName}"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" />
                        </Grid>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </DataTemplate>

        <DataTemplate DataType="{x:Type fields:BoolFieldViewModel}"
                      x:DataType="fields:BoolFieldViewModel">
            <Grid ColumnDefinitions="Auto,*">
                <Image Source="{Binding Icon}"
                       Width="{Binding IconSize}"
                       Height="{Binding IconSize}"
                       Margin="0,0,6,0"
                       VerticalAlignment="Center"
                       IsVisible="{Binding HasIcon}" />
                <CheckBox Grid.Column="1"
                          Content="{Binding Label}"
                          IsChecked="{Binding IsChecked}"
                          IsEnabled="{Binding IsEditable}"
                          MinHeight="32"
                          Margin="10,3,0,3"
                          VerticalAlignment="Center" />
            </Grid>
        </DataTemplate>

        <DataTemplate DataType="{x:Type fields:TriStateLockFieldViewModel}"
                      x:DataType="fields:TriStateLockFieldViewModel">
            <controls:TriStateLockCheckBox IsThreeState="True"
                                           IsChecked="{Binding StateValue, Mode=TwoWay}"
                                           Content="{Binding DisplayText}"
                                           IsEnabled="{Binding IsEditable}"
                                           MinHeight="32"
                                           Margin="10,3,0,3" />
        </DataTemplate>
    </Application.DataTemplates>

    <Application.Resources>
        <ResourceDictionary>
            <Color x:Key="SystemAccentColor">#0E8FA3</Color>
            <SolidColorBrush x:Key="AccentBrush" Color="#0E8FA3" />

            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#F3F3F3" />
                    <SolidColorBrush x:Key="AppSurfaceBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="AppSurfaceAltBrush" Color="#F7F7F7" />
                    <SolidColorBrush x:Key="AppBorderBrush" Color="#E0E0E0" />
                    <SolidColorBrush x:Key="AppForegroundBrush" Color="#1A1A1A" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#1F1F1F" />
                    <SolidColorBrush x:Key="AppSurfaceBrush" Color="#2B2B2B" />
                    <SolidColorBrush x:Key="AppSurfaceAltBrush" Color="#252525" />
                    <SolidColorBrush x:Key="AppBorderBrush" Color="#3A3A3A" />
                    <SolidColorBrush x:Key="AppForegroundBrush" Color="#F2F2F2" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <sty:FluentAvaloniaTheme PreferSystemTheme="True"
                                 CustomAccentColor="#0E8FA3" />

        <Style Selector="ButtonSpinner">
            <Setter Property="Template">
                <ControlTemplate>
                    <DataValidationErrors>
                        <Grid>
                            <ContentPresenter Name="PART_ContentPresenter"
                                              Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              HorizontalContentAlignment="Stretch"
                                              VerticalContentAlignment="Stretch" />
                            <RepeatButton Name="PART_DecreaseButton"
                                          Width="18"
                                          Height="26"
                                          Margin="2,0,0,0"
                                          Padding="0"
                                          HorizontalAlignment="Left"
                                          VerticalAlignment="Center"
                                          Background="Transparent"
                                          BorderThickness="0"
                                          CornerRadius="4"
                                          IsTabStop="False">
                                <Path Data="M 4,0 L 0,4 L 4,8"
                                      Stroke="{DynamicResource AppForegroundBrush}"
                                      StrokeThickness="1.2"
                                      StrokeLineCap="Round"
                                      Width="5"
                                      Height="9"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center" />
                            </RepeatButton>
                            <RepeatButton Name="PART_IncreaseButton"
                                          Width="18"
                                          Height="26"
                                          Margin="0,0,2,0"
                                          Padding="0"
                                          HorizontalAlignment="Right"
                                          VerticalAlignment="Center"
                                          Background="Transparent"
                                          BorderThickness="0"
                                          CornerRadius="4"
                                          IsTabStop="False">
                                <Path Data="M 0,0 L 4,4 L 0,8"
                                      Stroke="{DynamicResource AppForegroundBrush}"
                                      StrokeThickness="1.2"
                                      StrokeLineCap="Round"
                                      Width="5"
                                      Height="9"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center" />
                            </RepeatButton>
                        </Grid>
                    </DataValidationErrors>
                </ControlTemplate>
            </Setter>
        </Style>

        <Style Selector="ButtonSpinner TextBox#PART_TextBox">
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>

        <Style Selector="Button">
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Padding" Value="14,4" />
        </Style>

        <Style Selector="ToggleButton">
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="MinHeight" Value="32" />
        </Style>

        <Style Selector="TextBox">
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="MinHeight" Value="32" />
        </Style>

        <Style Selector="ComboBox">
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="MinHeight" Value="32" />
        </Style>

        <Style Selector="NumericUpDown">
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="MinHeight" Value="26" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <Style Selector="ComboBox.compact">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="6,2" />
            <Setter Property="MinHeight" Value="26" />
        </Style>

        <Style Selector="TabItem">
            <Setter Property="CornerRadius" Value="6,6,0,0" />
            <Setter Property="Padding" Value="12,5" />
            <Setter Property="FontSize" Value="13" />
        </Style>

        <Style Selector="TabItem:selected">
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
        </Style>

        <Style Selector="ListBoxItem">
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Margin" Value="2" />
            <Setter Property="Padding" Value="4" />
        </Style>

        <Style Selector="ListBoxItem:selected">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Foreground" Value="White" />
        </Style>

        <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Foreground" Value="White" />
        </Style>

        <Style Selector="Border.card">
            <Setter Property="Background" Value="{DynamicResource AppSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>

        <Style Selector="Border.fieldLabel">
            <Setter Property="Background" Value="{DynamicResource AppSurfaceAltBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="Padding" Value="6,3" />
            <Setter Property="Margin" Value="2,3,0,3" />
            <Setter Property="MinHeight" Value="32" />
        </Style>

        <Style Selector="Border.fieldLabel > TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextAlignment" Value="Center" />
        </Style>

        <Style Selector="TextBlock.sectionTitle">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="2,0,0,8" />
        </Style>

        <Style Selector="TextBlock.columnHeader">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Opacity" Value="0.7" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
    </Application.Styles>
</Application>
