<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\icon.ico</ApplicationIcon>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>

    <!-- Version metadata for the C# application. -->
    <AssemblyVersion>1.9.7.0</AssemblyVersion>
    <FileVersion>1.9.7.0</FileVersion>
    <Version>1.9.7</Version>
    <InformationalVersion>1.9.7</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Company>Hamano0813</Company>
    <Product>Fire Emblem Path of Radiance Modifier V1.9.7</Product>
    <AssemblyTitle>火焰纹章 苍炎的轨迹 动态修改器</AssemblyTitle>
    <Description>火焰纹章 苍炎的轨迹 动态修改器</Description>
    <Copyright>Copyright © 2021-2026 Hamano0813</Copyright>
    <Authors>Hamano0813</Authors>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
    <EmbeddedResource Include="Localization\terms.zh.json">
      <LogicalName>PoR.App.Localization.terms-zh.json</LogicalName>
      <WithCulture>false</WithCulture>
    </EmbeddedResource>
    <EmbeddedResource Include="Localization\terms.jp.json">
      <LogicalName>PoR.App.Localization.terms-jp.json</LogicalName>
      <WithCulture>false</WithCulture>
    </EmbeddedResource>
    <EmbeddedResource Include="Localization\ui.zh.json">
      <LogicalName>PoR.App.Localization.ui-zh.json</LogicalName>
      <WithCulture>false</WithCulture>
    </EmbeddedResource>
    <EmbeddedResource Include="Localization\ui.jp.json">
      <LogicalName>PoR.App.Localization.ui-jp.json</LogicalName>
      <WithCulture>false</WithCulture>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.6" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.6" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.6" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="AvaloniaFluentUI" Version="2.0.6" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PoR.Core\PoR.Core.csproj" />
    <ProjectReference Include="..\PoR.Game\PoR.Game.csproj" />
    <ProjectReference Include="..\PoR.Memory.Dolphin\PoR.Memory.Dolphin.csproj" />
  </ItemGroup>

  <!-- Publish output is meant to be a single distributable EXE. -->
  <Target Name="DeletePublishPdbs"
          AfterTargets="Publish"
          Condition="'$(PublishSingleFile)' == 'true'">
    <ItemGroup>
      <PublishPdbs Include="$(PublishDir)**\*.pdb" />
    </ItemGroup>
    <Delete Files="@(PublishPdbs)" />
  </Target>
</Project>
